# Dependencies
node_modules/
.pnp
.pnp.js

# Build output (we COPY dist/ into the nginx image at build time)
dist/
build/
*.tsbuildinfo

# Runtime data — user accounts, progress, reviews, audit logs.
# The dev DB is in server/data/, prod lives in a Docker named volume.
# `src/data/` is NOT ignored — that's the curated Kazakh card data
# (a1.json…c1.json) and the topic-name list (decks.json), both
# committed to the repo so a fresh clone has the full deck without
# needing to re-run the PDF parser.
server/data/
backups/
secrets/
/data/

# Pre-generated TTS audio lives in the repo (committed in main) so a
# fresh clone has audio without running the TTS pipeline. Lazy
# generation for user-added cards lands in the same directory at
# runtime — those new files are NOT gitignored, so a "wipe audio and
# rebuild" is `git checkout public/audio` followed by
# `docker compose --profile tools run --rm qazaq-tts` to regenerate
# anything missing.

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
npm-debug.log*

# Playwright e2e output (reports, traces, screenshots)
test-results/
playwright-report/
playwright/.cache/

# Throwaway screenshot scripts used during dev
_shot-*.mjs
_shot-*.png
verify-*.mjs
verify-*.js
deck-meta.test.js
src/deck-meta.test.js

# Local TTS model cache used by `scripts/generate-tts.py` and the
# Docker build. Downloaded on demand from HF, not part of the repo.
models/

# Test artifacts
coverage/

# Local env / secrets — never commit
.env
.env.local
.env.*.local
.env.*
!.env.production.example

# Misc
.cache/
.vite/
