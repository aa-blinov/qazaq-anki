# Production env for the qazaq-qazaq self-host stack.
# Copy to .env and fill in real values, then `docker compose up -d`.

# Comma-separated list of allowed origins. REQUIRED in production.
# Example: CORS_ORIGIN=https://qazaq.example.com,https://www.qazaq.example.com
CORS_ORIGIN=

# Where the SQLite file lives inside the API container. The default
# /data/qazaq.sqlite is on the qazaq-data named volume.
DB_PATH=/data/qazaq.sqlite

# Internal port for the API (exposed to nginx via compose DNS).
PORT=3001

# Public port for the web (nginx). Change to 80 if you want the default.
# WEB_PORT=8080
