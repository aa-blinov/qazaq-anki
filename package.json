{
  "name": "anki-qazaq",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.1.0",
  "type": "module",
  "description": "Anki-style flashcards for learning Kazakh (Қазақ тілі) by CEFR level A1-C1. Spaced repetition, offline, runs on GitHub Pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node vite-spa-fallback.config.ts",
    "build:quick": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:pages": "VITE_BASE=/qazaq-anki/ npm run build",
    "deploy": "npx gh-pages -d landing -m \"deploy: landing\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "server": "node --watch server.js",
    "start": "node server.js",
    "deploy:app": "npm run build:pages && npx gh-pages -d dist"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
