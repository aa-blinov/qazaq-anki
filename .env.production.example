# .env.production — copy to .env.production and fill in.
# Used by: `docker compose --profile prod up`.

# Caddy / Let's Encrypt.
# - CADDY_DOMAIN must be a public DNS A/AAAA pointing at this host.
# - Port 80 must be open to the internet for the http-01 challenge.
# - Port 443 is the service port users hit.
# These are REQUIRED when running with `--profile prod` —
# Caddy refuses to start without them.
CADDY_DOMAIN=anki.example.com
CADDY_EMAIL=ops@example.com

# Admin shared secret between qazaq-api and qazaq-backup.
# Generate with: openssl rand -hex 32
# Required for: the /api/admin/checkpoint and /api/admin/backup-now
# endpoints (used by the backup container to flush + snapshot).
# If unset, those endpoints return 404 and the backup container
# refuses to run.
ADMIN_TOKEN=replace-me-with-openssl-rand-hex-32
ADMIN_TOKEN_FILE=./secrets/admin_token.txt

# CORS origin the API allows. In prod this is the HTTPS host
# the Caddy container serves, NOT the local nginx port.
CORS_ORIGIN=https://anki.example.com

# Backup schedule. Cron syntax. Default hourly. Set to "off"
# to run once and exit (useful for manual docker compose run).
BACKUP_CRON=0 * * * *
